{
  "name": "@esigner/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript client for the esigner e-signing API: BankID, MitID and other eID signature requests, signed PDFs and verified webhooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "esigner",
    "e-signature",
    "esignature",
    "bankid",
    "mitid",
    "eid",
    "signing",
    "pdf",
    "webhooks"
  ],
  "homepage": "https://esigner.no/dokumentasjon",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/generated/openapi.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
